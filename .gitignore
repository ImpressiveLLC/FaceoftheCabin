node_modules/
test-results/
playwright-report/
__pycache__/
*.pyc

# Ansible Vault password — decrypts every secret in ansible/group_vars/.
# Must live outside this repo (see ansible/README.md's Secrets section);
# this entry is a safety net in case it's ever created inside the tree by
# mistake, not the primary control.
.ansible_vault_pass
*.vault_pass

# Real per-host env files (HA_TOKEN, POSTGRES_PASSWORD, the ntfy alert
# topic, etc.) — only the .example templates are meant to be tracked.
# Same safety-net reasoning as the vault password above: this shouldn't be
# the only thing standing between a secret and a commit, but it helps.
cabin-orchestration-platform/infra/.env
cabin-orchestration-platform/locations/*/.env
