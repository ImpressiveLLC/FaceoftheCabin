# Production stack (mosquitto, Frigate, Zigbee2MQTT, Home Assistant, etc.)
# — environment variables. Copy to production-stack/.env before running
# docker compose:
#   cp .env.production-stack.example .env
# Then fill in the values marked REQUIRED. This .env is never committed —
# same posture as infra/.env.m920q.example.

# ── Camera password (Reolink/Frigate) ───────────────────────────
# Same variable name as infra/.env.m920q.example's CAMERA_PASSWORD, but a
# separate value in a separate .env file for a separate camera set — this
# stack's cabin cameras (Frigate/mediamtx here), not FaceoftheCabin's own
# home-cam-* RTSP entries in docker-compose.yml. No collision at the shell
# or compose level (different .env files), just a naming coincidence.
CAMERA_PASSWORD=REQUIRED_change_me

# ── Blink camera bridge (blinkbridge) ───────────────────────────
BLINK_USERNAME=REQUIRED_change_me
BLINK_PASSWORD=REQUIRED_change_me
