  {
    "id": "door-transition",
    "type": "function",
    "z": "cabin-security-tab",
    "name": "Closed → open only",
    "func": "let payload = msg.payload;\nif (typeof payload === 'string') {\n    try { payload = JSON.parse(payload); } catch (error) { return null; }\n}\nif (typeof payload?.contact !== 'boolean') return null;\nconst stateKey = `contact:${msg.topic}`;\nconst previous = flow.get(stateKey);\nflow.set(stateKey, payload.contact);\n// Never alarm from the first observation after startup or deploy.\nif (previous === undefined) {\n    node.status({fill:'grey', shape:'ring', text:`initialized ${payload.contact ? 'closed' : 'open'}`});\n    return null;\n}\nif (previous === true && payload.contact === false) {\n    msg.door = msg.topic.endsWith('door_front_contact') ? 'front' : 'second';\n    msg.detectedAt = new Date().toISOString();\n    msg.originalPayload = payload;\n    node.status({fill:'yellow', shape:'dot', text:`${msg.door} opened`});\n    return msg;\n}\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 255,
    "wires": [
      [
        "entry-delay"
      ]
    ]
  },
