  {
    "id": "presence-seen-state",
    "type": "function",
    "z": "cabin-security-tab",
    "name": "Remember phone last seen",
    "func": "const limitHours=Number(env.get('PRESENCE_STALE_HOURS'))>0?Number(env.get('PRESENCE_STALE_HOURS')):6;\nconst raw=String(msg.payload).trim();\nconst t=Date.parse(raw);\nif(!raw||Number.isNaN(t)){node.status({fill:'red',shape:'ring',text:'bad last_seen: '+raw.slice(0,24)});return null;}\nflow.set('presenceSeenAt',t);\nconst h=(Date.now()-t)/3600000;\nnode.status({fill:h>limitHours?'yellow':'green',shape:'dot',text:'phone seen '+h.toFixed(1)+' h ago'});\nreturn null;",
    "outputs": 0,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 180,
    "wires": []
