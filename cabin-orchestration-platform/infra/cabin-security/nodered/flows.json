  {
    "id": "security-gate",
    "type": "function",
    "z": "cabin-security-tab",
    "name": "Require enabled + armed + Nate away (stale presence: push only)",
    "func": "const enabled=flow.get('automationEnabled')===true;\nconst armed=flow.get('armedAway')===true;\nconst presence=String(flow.get('natePresence')||'unknown').toLowerCase();\nconst now=Date.now(),last=Number(flow.get('lastAlarmAt')||0);\n// W-33: age of the presence signal. presenceSeenAt is the phone's last Companion\n// report, published by Home Assistant as cabin/presence/nate/last_seen. 0 means no\n// heartbeat has ever been seen, and then the rule stays inactive (deploy order\n// does not matter). Limit: env PRESENCE_STALE_HOURS, default 6.\nconst limitHours=Number(env.get('PRESENCE_STALE_HOURS'))>0?Number(env.get('PRESENCE_STALE_HOURS')):6;\nconst seenAt=Number(flow.get('presenceSeenAt')||0);\nconst ageHours=seenAt>0?(now-seenAt)/3600000:null;\nconst stale=ageHours!==null&&ageHours>limitHours;\nlet decision='blocked',reason='',push=null;\nif(!enabled)reason='automation disabled';\nelse if(!armed)reason='system disarmed';\nelse if(stale){\n  if(now-Number(flow.get('lastStalePushAt')||0)<600000)reason='presence stale; push cooldown active (10 minutes)';\n  else{\n    decision='stale_push_only';\n    reason='presence signal is '+ageHours.toFixed(1)+' h old (limit '+limitHours+' h): push alert only, no siren';\n    flow.set('lastStalePushAt',now);\n    push={topic:'cabin/event/critical',payload:JSON.stringify({event:'INTRUSION_CANDIDATE_STALE_PRESENCE',deviceId:'cabin-security',door:msg.door,detectedAt:msg.detectedAt,natePresence:presence,presenceAgeHours:Number(ageHours.toFixed(1)),staleLimitHours:limitHours,sirenSounded:false,reason}),qos:1,retain:false};\n  }\n}\nelse if(presence==='home')reason='Nate is home';\nelse if(presence!=='not_home')reason='presence unknown — fail safe';\nelse if(now-last<600000)reason='10 minute cooldown active';\nelse{decision='alarm_candidate';reason='enabled, armed, and Nate is away';flow.set('lastAlarmAt',now);}\nconst audit={topic:'cabin/security/intrusion/event',payload:JSON.stringify({decision,reason,door:msg.door,detectedAt:msg.detectedAt,evaluatedAt:new Date().toISOString(),automationEnabled:enabled,armedAway:armed,natePresence:presence,presenceAgeHours:ageHours===null?null:Number(ageHours.toFixed(1)),presenceStale:stale,staleLimitHours:limitHours,liveSirensEnabled:true}),qos:1,retain:false};\nnode.status({fill:decision==='alarm_candidate'?'red':(decision==='stale_push_only'?'yellow':'green'),shape:'dot',text:reason});\nreturn [decision==='alarm_candidate'?msg:null,audit,push];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 920,
    "y": 255,
    "wires": [
      [
        "alarm-on"
      ],
      [
        "audit-out",
        "audit-debug"
      ],
      [
        "push-alert-out"
      ]
    ]
  },
