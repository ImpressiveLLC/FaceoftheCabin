# M920q Cabin Hub — environment variables
# Copy to infra/.env before running docker compose:
#   cp .env.m920q.example .env
# Then fill in the values marked REQUIRED.

# ── Postgres (started by this stack) ────────────────────────────
POSTGRES_PASSWORD=REQUIRED_change_me

# ── Grafana ──────────────────────────────────────────────────────
GRAFANA_PASSWORD=REQUIRED_change_me

# ── Home Assistant token (get from HA → Profile → Long-Lived Tokens)
HA_TOKEN=REQUIRED_paste_ha_long_lived_token_here

# ── Home hub (not yet deployed — leave blank) ────────────────────
HOME_HA_URL=
HOME_HA_TOKEN=

# ── Family Hub URL (use Tailscale MagicDNS — IP addresses are blocked by Google OAuth)
# Find your FQDN: tailscale status --json | grep DNSName   (on the M920q)
# Example: http://m920q.tail1234ab.ts.net:4081
FAMILY_HUB_URL=http://100.77.44.113:4081

# ── Google OAuth Client ID for the Family Hub — baked into the image at
# build time (see family-hub/Dockerfile) so every device that loads the
# page from this host gets it automatically; no per-device Settings entry
# needed. Not a secret — Web application Client IDs are visible client-side
# by design. Create at console.cloud.google.com -> APIs & Services ->
# Credentials -> Web application; Authorized JavaScript origin must match
# FAMILY_HUB_URL above exactly (host + port, no path).
GOOGLE_CLIENT_ID=

# ── Family Hub admin — comma-separated Google account emails allowed to
# see/export the per-user access log (Settings -> Access Log). Also baked
# in at build time, same as GOOGLE_CLIENT_ID above — was hardcoded in the
# app source before this was added, meaning a template fork would've had
# to edit and rebuild just to change who's an admin.
# Example: ADMIN_EMAILS=owner@gmail.com,co-parent@gmail.com
ADMIN_EMAILS=

# ── Camera password (Reolink/Frigate) ───────────────────────────
CAMERA_PASSWORD=
