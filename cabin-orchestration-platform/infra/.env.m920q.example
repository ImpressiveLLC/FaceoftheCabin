# M920q Cabin Hub — environment variables
# Copy to infra/.env before running docker compose:
#   cp .env.m920q.example .env
# Then fill in the values marked REQUIRED.

# ── Postgres (started by this stack) ────────────────────────────
POSTGRES_PASSWORD=REQUIRED_change_me

# ── Grafana ──────────────────────────────────────────────────────
GRAFANA_PASSWORD=REQUIRED_change_me
# Optional. The externally-reachable address Grafana's own redirect URL
# (GF_SERVER_ROOT_URL) is built from -- defaults to this instance's
# Tailscale IP. Get this wrong and every request redirects to
# "localhost" on the viewer's own machine instead of the real host --
# see docs/MAINTENANCE.md's Grafana section for the incident this fixed.
GRAFANA_EXTERNAL_HOST=100.77.44.113

# ── Home Assistant token (get from HA → Profile → Long-Lived Tokens)
HA_TOKEN=REQUIRED_paste_ha_long_lived_token_here

# ── Home hub (not yet deployed — leave blank) ────────────────────
HOME_HA_URL=
HOME_HA_TOKEN=

# ── Family Hub URL — used two ways: (1) this value directly, as the
# fallback default baked into cabin-ui's Family Hub iframe panel; (2) it's
# also just informational for wherever you actually navigate to sign in
# (Google OAuth needs the browser's real origin, this var doesn't affect
# that). Now that hub.unicornpingpong.com is live via Cloudflare Tunnel,
# prefer that over a Tailscale-only address — a non-Tailscale visitor to
# cabin-ui's Family Hub panel needs a URL that's actually reachable for them.
# If you want the panel Tailscale-only instead (private), use your Tailscale
# MagicDNS FQDN: tailscale status --json | grep DNSName (on the M920q).
FAMILY_HUB_URL=https://hub.unicornpingpong.com

# ── Cabin API base — build-time API endpoint for BOTH cabin-ui (device list/
# status) and, as of 2026-08-01, family-hub (notes/chores cross-device sync,
# via cabin-backend's new /api/notes and /api/chores). Defaults to the public
# api.unicornpingpong.com if unset (see docker-compose.m920q.yml); override
# here only if you want both built against a Tailscale-only backend instead
# (matches FAMILY_HUB_URL's private option above — pick one consistently,
# not a mix — a public family-hub pointed at a Tailscale-only API would just
# fail every sync call for a non-Tailscale visitor).
CABIN_API_URL=https://api.unicornpingpong.com

# ── Google OAuth Client ID for the Family Hub — baked into the image at
# build time (see family-hub/Dockerfile) so every device that loads the
# page from this host gets it automatically; no per-device Settings entry
# needed. Not a secret — Web application Client IDs are visible client-side
# by design. Create at console.cloud.google.com -> APIs & Services ->
# Credentials -> Web application; Authorized JavaScript origin must match
# FAMILY_HUB_URL above exactly (host + port, no path).
GOOGLE_CLIENT_ID=

# ── Google OAuth Client Secret — UNLIKE GOOGLE_CLIENT_ID above, this one
# really is a secret. Only needed if a server-side OAuth flow is in use
# (Grafana's own Google login, added 2026-08-04) -- family-hub/cabin-ui's
# own sign-in is a client-side implicit flow that never needs this.
# Same Credentials page as GOOGLE_CLIENT_ID -- click the Web application
# client, copy "Client secret". Leave blank to keep Grafana's Google auth
# disabled (a valid, working state).
GOOGLE_CLIENT_SECRET=

# ── Family Hub admin — comma-separated Google account emails allowed to
# see/export the per-user access log (Settings -> Access Log). Also baked
# in at build time, same as GOOGLE_CLIENT_ID above — was hardcoded in the
# app source before this was added, meaning a template fork would've had
# to edit and rebuild just to change who's an admin.
# Example: ADMIN_EMAILS=owner@gmail.com,co-parent@gmail.com
ADMIN_EMAILS=

# ── Camera password (Reolink/Frigate) ───────────────────────────
CAMERA_PASSWORD=

# ── ntfy.sh topic for CRITICAL alert push (NtfyAlertPublisher) ───
# Optional. Water leak / smoke / alarm events POST to https://ntfy.sh/{this
# topic}. Reuses the same delivery mechanism as the existing Node-RED
# overnight-camera-alert flow -- get the topic name from that same ntfy
# subscription rather than creating a second one. Leave blank to keep
# CRITICAL events persisting to cabin_event with no phone push. The topic
# name functions as a shared secret (ntfy.sh topics aren't access-controlled
# by default) -- treat it like a password, never commit a real value here.
CABIN_ALERT_NTFY_TOPIC=

# ── Template configuration: instance platform + remote access ────
# Displayed read-only in the Config panel's Platform/Remote Access cards
# (docs/REPLICATION.md §2/§4 — "fields that require entry" for a template
# clone). CABIN_INSTANCE_REMOTE_ACCESS is comma-separated and defaults to
# "Tailscale" if left blank, the documented default remote-access path
# for a fresh instance -- everything else here defaults to a "not
# configured yet" string instead of guessing.
# Example: CABIN_INSTANCE_PLATFORM=Self-hosted — Lenovo ThinkCentre M920q, Ubuntu 24.04, x86_64
CABIN_INSTANCE_PLATFORM=
# Example: CABIN_INSTANCE_REMOTE_ACCESS=Tailscale,Cloudflare Tunnel
CABIN_INSTANCE_REMOTE_ACCESS=

# ── Tech ID Service findings-submission key ─────────────────────
# Optional. Any provider (this instance's own scheduled scan, an
# operator's paid scanning tier, or your own AI pipeline) must present
# this value via the X-Tech-Id-Api-Key header to POST /api/tech-id/findings.
# Leave blank to keep the endpoint closed (returns 503) -- see
# docs/REPLICATION.md §8 before setting a real value.
TECH_ID_API_KEY=

# ── cabin-discovery: device self-discovery / assisted-onboarding ─
# Optional. Used only by the cabin-discovery service (not cabin-backend
# directly) to look up an identified device via the Anthropic API's
# web-search tool -- device metadata (vendor/model/discovery attributes)
# is sent off this host to do so. Leave blank to keep the feature
# working in local-catalog-only mode (whatever the discovering
# integration already reported, no external lookup, no data leaves the
# host). Treat it like a password, never commit a real value here.
ANTHROPIC_API_KEY=

# Optional, only needed alongside ANTHROPIC_API_KEY above if that key is an
# "identity-linked" key (Anthropic's newer per-member type, seen on an
# Individual Org / evaluation-access plan) -- the API otherwise rejects
# every request from one of these with a 400 until told which workspace to
# act in. Find it in the Console URL when viewing that workspace's own
# pages (e.g. /settings/workspaces/default/keys -- the slug there, "default"
# in that example, is the value this wants). A workspace-owned key on a
# paid team org may not need this set at all.
ANTHROPIC_WORKSPACE_ID=
