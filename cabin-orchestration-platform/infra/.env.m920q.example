# M920q Cabin Hub — environment variables
# Copy to infra/.env before running docker compose on the M920q:
#   cp .env.m920q.example .env
#
# The backend reads these via application.yml (spring.config.import=optional:file:.env)
# or set them as shell env vars before ./mvnw spring-boot:run

# ── Postgres (started by docker-compose.m920q.yml) ──────────────
POSTGRES_PASSWORD=your_secure_password_here

# ── Kafka (started by docker-compose.m920q.yml) ─────────────────
# KAFKA_BOOTSTRAP is localhost:9092 by default — no change needed

# ── MQTT (existing 'mosquitto' container) ────────────────────────
MQTT_URL=tcp://localhost:1883

# ── Home Assistant (existing 'homeassistant' container, host network) ─
HA_URL=http://localhost:8123
HA_TOKEN=your_ha_long_lived_token_here

# ── Grafana (started by docker-compose.m920q.yml on port 3002) ──
GRAFANA_PASSWORD=your_grafana_password_here

# ── Camera password (existing Frigate container) ─────────────────
CAMERA_PASSWORD=your_camera_password_here

# ── Home hub (not yet deployed — leave blank) ────────────────────
# HOME_HA_URL=
# HOME_HA_TOKEN=
