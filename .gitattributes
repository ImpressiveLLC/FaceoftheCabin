# Ansible Vault's encrypted format is a plain-text armor over binary
# ciphertext -- CRLF normalization on a Windows checkout risks silently
# corrupting it in a way that only surfaces the next time someone tries to
# decrypt (verified once by hand this session; not relying on luck again).
ansible/group_vars/**/vault.yml -text

# Shell scripts run with #!/bin/sh on Linux hosts -- CRLF line endings
# break the shebang line and every subsequent line silently (found this
# risk while adding check_nate_phone_wifi.sh from a Windows checkout;
# forcing LF here rather than relying on this session's git config).
*.sh text eol=lf


scripts/host/backup-modular text eol=lf
scripts/host/blinkbridge-watchdog* text eol=lf

# Extensionless host scripts (scripts/host/*) are copied to Linux and run directly.
scripts/host/* text eol=lf

# Intent/slot data is graded and fingerprinted by raw bytes (gold_sha256). A Windows autocrlf checkout
# hashed differently from the Linux host and the grading UI rejected the 2026-10-17 baseline report.
docs/ai-assistant/training/intent-slot/*.jsonl text eol=lf
docs/ai-assistant/training/intent-slot/*.json text eol=lf
docs/ai-assistant/training/intent-slot/system.txt text eol=lf
docs/ai-assistant/training/intent-slot/Modelfile.* text eol=lf
