  {
    "id": "train-entry-timer",
    "utterances": [
      "At home in the entry, when the front door contact opens and the illuminance sensor is below 20 lux, turn the lights on then off after 120 seconds."
    ],
    "target": {
      "intent": "propose_automation",
      "slots": {},
      "requires_confirmation": true,
      "clarification": null,
      "automation": {
        "trigger": {
          "target": {
            "device_name": "front door contact",
            "location": "entry",
            "site": "home"
          },
          "attribute": "contact",
          "operator": "eq",
          "value": "open",
          "unit": null
        },
        "conditions": [
          {
            "target": {
              "device_name": "illuminance sensor",
              "location": "entry",
              "site": "home"
            },
            "attribute": "illuminance",
            "operator": "lt",
            "value": "20",
            "unit": "lux"
          }
        ],
        "actions": [
          {
            "target": {
              "device_name": "lights",
              "location": "entry",
              "site": "home"
            },
            "operation": "on",
            "attribute": null,
            "value": null,
            "unit": null,
            "delay_seconds": 0
          },
          {
            "target": {
              "device_name": "lights",
              "location": "entry",
              "site": "home"
            },
            "operation": "off",
            "attribute": null,
            "value": null,
            "unit": null,
            "delay_seconds": 120
          }
        ]
      }
    }
  },
