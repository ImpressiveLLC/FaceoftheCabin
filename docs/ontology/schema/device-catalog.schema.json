{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faceofthecabin.example/schema/device-catalog.schema.json",
  "title": "Device catalog (generated; S2, design #475)",
  "description": "One entry per DeviceType constant plus the ontology-only types. Generated by scripts/ontology/generate_catalog.py from docs/ontology.yaml, DeviceType.java and docs/ontology/catalog-seed.yaml; never hand-edited.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_from", "safety_types", "allowed_changes", "match_rules", "entries", "catalog_hash"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "catalog_hash": {"$ref": "#/$defs/sha256"},
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ontology_sha256", "ontology_version_label", "device_type_source_sha256", "seed_sha256", "generator_version"],
      "properties": {
        "ontology_sha256": {"$ref": "#/$defs/sha256"},
        "ontology_version_label": {"type": "string", "description": "A label for humans only; the hash decides staleness (S8 ruling Q4)."},
        "device_type_source_sha256": {"$ref": "#/$defs/sha256"},
        "seed_sha256": {"$ref": "#/$defs/sha256"},
        "generator_version": {"type": "integer", "minimum": 1}
      }
    },
    "safety_types": {"type": "array", "items": {"$ref": "#/$defs/typeName"}, "uniqueItems": true},
    "allowed_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "change", "reason"],
        "properties": {
          "type": {"$ref": "#/$defs/typeName"},
          "change": {"enum": ["removed", "category", "checkin"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "match_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "site", "returns", "describes", "source", "input"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z]{2}-[0-9]{2}-[a-z0-9-]+$"},
          "site": {"enum": ["home_assistant", "zigbee2mqtt", "mqtt_bridge"]},
          "returns": {"$ref": "#/$defs/typeName"},
          "describes": {"type": "string", "minLength": 1},
          "source": {"const": "inferType"},
          "input": {"type": "object"}
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "category", "reported_fields", "triggers_naming_type", "protocols", "match_rule_ids", "checkin_minutes", "reason", "field_sources", "stamp"],
        "properties": {
          "id": {"$ref": "#/$defs/typeName"},
          "status": {"enum": ["enum", "ontology_only"]},
          "category": {"enum": ["SAFETY", "SECURITY", "CLIMATE", "UTILITIES", "APPLIANCES", "NETWORK", "PLATFORM", null]},
          "reported_fields": {"type": "array", "items": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"}, "uniqueItems": true},
          "triggers_naming_type": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "protocols": {"type": "array", "items": {"enum": ["home_assistant", "zigbee2mqtt", "mqtt_bridge"]}, "uniqueItems": true},
          "match_rule_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "checkin_minutes": {
            "oneOf": [
              {"type": "null"},
              {"type": "object", "additionalProperties": false, "required": ["non_zigbee", "zigbee_mains", "zigbee_battery"],
               "properties": {"non_zigbee": {"type": "integer", "minimum": 1}, "zigbee_mains": {"type": "integer", "minimum": 1}, "zigbee_battery": {"type": "integer", "minimum": 1}}}
            ]
          },
          "reason": {"type": ["string", "null"]},
          "field_sources": {"type": "object", "additionalProperties": {"type": "string"}},
          "stamp": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ontology_content_hash", "seed_hash", "source_hash"],
            "properties": {
              "ontology_content_hash": {"$ref": "#/$defs/sha256"},
              "seed_hash": {"$ref": "#/$defs/sha256"},
              "source_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "ontology_only"}}},
           "then": {"properties": {"category": {"type": "null"}, "checkin_minutes": {"type": "null"}, "reason": {"type": "string", "minLength": 1}}}},
          {"if": {"properties": {"status": {"const": "enum"}}},
           "then": {"properties": {"category": {"type": "string"}, "checkin_minutes": {"type": "object"}}}}
        ]
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "typeName": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
  }
}
