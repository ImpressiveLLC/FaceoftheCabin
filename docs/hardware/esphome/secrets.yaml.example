# Template only. Copy to secrets.yaml in this folder (it is gitignored) and fill in
# real values. NEVER put real values in this file, commit them, paste them in chat,
# or print them. System of record: your password manager (see README.md).
#
# Generate a key:   openssl rand -base64 32      (44 characters ending in "=")
# The all-zeros key is rejected by ESPHome.
#
# Names match what each box YAML and tools/read_box2.py read today:
# box2.yaml and read_box2.py use api_key and ota_password (Box 2 only);
# box3.yaml uses box3_api_key and box3_ota_password. ap_password is shared.
# If you already have a working secrets.yaml, DO NOT overwrite it: add only the
# missing names. Existing values are never changed by this template.
ap_password: "CHANGE-ME-setup-ap-password"
api_key: "CHANGE-ME-base64-32-bytes"            # Box 2
ota_password: "CHANGE-ME"                       # Box 2
box3_api_key: "CHANGE-ME-base64-32-bytes"
box3_ota_password: "CHANGE-ME"
# box4_api_key / box4_ota_password: add when Box 4 gets firmware (W-84).
