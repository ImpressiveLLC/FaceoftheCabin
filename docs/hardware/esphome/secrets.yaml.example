# Template only. Copy to secrets.yaml in this folder (it is gitignored) and fill in
# real values. NEVER put real values in this file, commit them, paste them in chat,
# or print them. The system of record is the vault (Vaultwarden); see README.md.
#
# Generate a key:   openssl rand -base64 32      (44 characters ending in "=")
# The all-zeros key is rejected by ESPHome.
#
# One api key and one OTA password per node. ap_password is shared by all nodes.
ap_password: "CHANGE-ME-setup-ap-password"
box2_api_key: "CHANGE-ME-base64-32-bytes"
box2_ota_password: "CHANGE-ME"
box3_api_key: "CHANGE-ME-base64-32-bytes"
box3_ota_password: "CHANGE-ME"
# box4_api_key / box4_ota_password: add when Box 4 gets firmware (W-84).
