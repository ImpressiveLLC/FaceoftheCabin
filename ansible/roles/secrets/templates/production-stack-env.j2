# M920q Cabin Hub — production-stack environment variables
# GENERATED by Ansible (ansible/roles/secrets) from
# group_vars/{{ group_names | first }}/vault.yml + vars.yml — do not
# hand-edit this file, it will be silently overwritten the next time the
# secrets role or rotate-secrets.yml runs. Edit the vault instead:
#   ansible-vault edit group_vars/cabin/vault.yml --vault-password-file ~/.ansible_vault_pass
#
# This is the pre-existing, separately-managed stack's own .env (mosquitto,
# Home Assistant, Node-RED, Frigate, Zigbee2MQTT, blinkbridge, mediamtx,
# uptime-kuma, homepage) — brought under git version control 2026-08-14
# but this file itself stayed gitignored and hand-maintained until this
# template was added. Distinct from the OTHER env.j2 in this same role,
# which generates the app-level cabin-orchestration-platform/infra/.env for
# cabin-backend/cabin-ui/family-hub — two separate stacks, two separate
# generated files.
#
# NOT included here: TUNNEL_TOKEN (cloudflared). cloudflared is
# deliberately outside this repo's compose/ansible management today (see
# docker-compose.m920q.yml's own comment on the cabin-ui service:
# "cloudflared here is token-managed, not a local config file this repo
# can drive") — its token is vault-stored as a backup reference
# (vault_cloudflare_tunnel_token) but never auto-applied anywhere. See
# ansible/README.md's credential checklist for the manual recreate
# procedure, and its note on bringing cloudflared under real management
# later if that's ever wanted.

# ── Blink cloud account (blinkbridge -> Blink Outdoor 4 "driveway") ─────
BLINK_USERNAME={{ blink_username }}
BLINK_PASSWORD={{ blink_password }}

# ── Reolink/Frigate camera admin password — same value as the app-level
# .env's CAMERA_PASSWORD (one vault source of truth, used in two places).
CAMERA_PASSWORD={{ camera_password }}
