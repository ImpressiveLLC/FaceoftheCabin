# M920q Cabin Hub — environment variables
# GENERATED by Ansible (ansible/roles/secrets) from
# group_vars/{{ group_names | first }}/vault.yml + vars.yml — do not
# hand-edit this file, it will be silently overwritten the next time the
# secrets role or rotate-secrets.yml runs. Edit the vault instead:
#   ansible-vault edit group_vars/cabin/vault.yml --vault-password-file ~/.ansible_vault_pass

# ── Postgres (started by this stack) ────────────────────────────
POSTGRES_PASSWORD={{ postgres_password }}

# ── Grafana ──────────────────────────────────────────────────────
GRAFANA_PASSWORD={{ grafana_password }}

# ── Home Assistant token (get from HA → Profile → Long-Lived Tokens)
HA_TOKEN={{ ha_token }}

# ── Home hub (not yet deployed — leave blank) ────────────────────
HOME_HA_URL={{ home_ha_url }}
HOME_HA_TOKEN={{ home_ha_token }}

# ── Family Hub URL — see .env.m920q.example for the full explanation of
# what this controls; unchanged by the secrets role, just passed through.
FAMILY_HUB_URL={{ family_hub_url }}

# ── Cabin API base — see .env.m920q.example.
CABIN_API_URL={{ cabin_api_url }}

# ── Google OAuth Client ID — not a secret (Web application Client IDs are
# visible client-side by design), templated here anyway for one source of
# truth. Authorized JavaScript origin must match FAMILY_HUB_URL exactly.
GOOGLE_CLIENT_ID={{ google_client_id }}

# ── Google OAuth Client Secret — a REAL secret, unlike the Client ID
# above. Only needed for server-side OAuth flows (Grafana's own Google
# login); empty is valid and just leaves that disabled. See vars.yml's
# comment for where to get this value.
GOOGLE_CLIENT_SECRET={{ google_client_secret }}

# ── Family Hub admin — comma-separated Google account emails.
ADMIN_EMAILS={{ admin_emails }}

# ── Camera password (Reolink/Frigate) ───────────────────────────
CAMERA_PASSWORD={{ camera_password }}

# ── Tech ID Service findings-submission key — optional, empty by default.
# See docs/REPLICATION.md §8 before setting this to a real value.
TECH_ID_API_KEY={{ tech_id_api_key }}

# ── cabin-discovery: device self-discovery lookup — optional, empty by
# default. See .env.m920q.example for the full explanation.
ANTHROPIC_API_KEY={{ anthropic_api_key }}

# ── ntfy.sh topic for CRITICAL workflow/automation push alerts — optional,
# empty by default (alerts still persist/show in-app either way).
CABIN_ALERT_NTFY_TOPIC={{ cabin_alert_ntfy_topic }}

# ── Resend API key for Tier 2 managed-user magic-link invite emails —
# optional, empty by default (inviting a managed user fails loudly with a
# clear error until this is set). See docs/REPLICATION.md §3.
RESEND_API_KEY={{ resend_api_key }}

# ── Where a Tier 2 managed user's magic link points — must match
# cabin-ui's real public origin.
CABIN_FRONTEND_ORIGIN={{ cabin_frontend_origin }}

# ── Blink motion webhook shared secret (BlinkMotionWebhookController) —
# optional, empty by default (endpoint refuses with 503 until set). This
# instance already has a real live value — see vars.yml's own comment for
# why this line was missing until 2026-09-03.
BLINK_MOTION_WEBHOOK_API_KEY={{ blink_motion_webhook_api_key }}
