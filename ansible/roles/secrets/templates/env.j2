# M920q Cabin Hub — environment variables
# GENERATED by Ansible (ansible/roles/secrets) from
# group_vars/{{ inventory_hostname_group }}/vault.yml + vars.yml — do not
# hand-edit this file, it will be silently overwritten the next time the
# secrets role or rotate-secrets.yml runs. Edit the vault instead:
#   ansible-vault edit group_vars/cabin/vault.yml --vault-password-file ~/.ansible_vault_pass

# ── Postgres (started by this stack) ────────────────────────────
POSTGRES_PASSWORD={{ postgres_password }}

# ── Grafana ──────────────────────────────────────────────────────
GRAFANA_PASSWORD={{ grafana_password }}

# ── Home Assistant token (get from HA → Profile → Long-Lived Tokens)
HA_TOKEN={{ ha_token }}

# ── Home hub (not yet deployed — leave blank) ────────────────────
HOME_HA_URL={{ home_ha_url }}
HOME_HA_TOKEN={{ home_ha_token }}

# ── Family Hub URL — see .env.m920q.example for the full explanation of
# what this controls; unchanged by the secrets role, just passed through.
FAMILY_HUB_URL={{ family_hub_url }}

# ── Cabin API base — see .env.m920q.example.
CABIN_API_URL={{ cabin_api_url }}

# ── Google OAuth Client ID — not a secret (Web application Client IDs are
# visible client-side by design), templated here anyway for one source of
# truth. Authorized JavaScript origin must match FAMILY_HUB_URL exactly.
GOOGLE_CLIENT_ID={{ google_client_id }}

# ── Family Hub admin — comma-separated Google account emails.
ADMIN_EMAILS={{ admin_emails }}

# ── Camera password (Reolink/Frigate) ───────────────────────────
CAMERA_PASSWORD={{ camera_password }}
